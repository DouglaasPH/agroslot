# Banco de dados (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/agroslot_db
DB_USER=seu_usuario_do_banco
DB_PASSWORD=sua_senha_do_banco

# MinIO (armazenamento de imagens)
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=sua_access_key
MINIO_SECRET_KEY=sua_secret_key
MINIO_BUCKET_NAME=agroslot.images

# JWT
# Use um segredo longo e aleatório (ex.: openssl rand -base64 48)
APP_JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
APP_JWT_EXPIRATION_MS=86400000

# E-mail (SMTP)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=nao-responda@ecoa.com

# Logs
JPA_SHOW_SQL=true

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-app
MAIL_FROM=nao-responda@ecoa.com